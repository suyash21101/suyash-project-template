{
  "stages": {
    "lint": { "enabled": true },
    "typecheck": { "enabled": true },
    "test": { "enabled": true, "coverage_min": 80 },
    "build": { "enabled": true },
    "prisma_validate": { "enabled": false },
    "bundle_size": { "enabled": false, "threshold_kb": 50 },
    "security_scan": { "enabled": false, "block_on": "critical" },
    "regression": { "enabled": false },
    "migration_safety": { "enabled": true },
    "e2e": { "enabled": false, "run_on": ["staging", "main"] },
    "a11y": { "enabled": false },
    "lighthouse": { "enabled": false, "min_score": 90 },
    "pr_review": { "enabled": false, "model": "sonnet" },
    "sanity_check": { "enabled": false },
    "knowledge_graph": { "enabled": true }
  },
  "deploy": { "mode": "fargate", "aws_region": "ap-south-1", "migrate": true }
}
